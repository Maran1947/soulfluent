# App
APP_NAME=SoulFluent
ENVIRONMENT=development

# Auth
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Native mode (backend runs on your Mac, Postgres via `make db`): use localhost:5346
# Full Docker mode (backend also containerized via `make up`): use db:5432 instead
DATABASE_URL=postgresql+asyncpg://fluentsoul:fluentsoul@localhost:5346/flountsoul

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Object storage (Cloud Storage / MinIO, S3-compatible) for turn audio
# Native mode (backend runs on your Mac, MinIO via `make minio`): use localhost:9010
# Full Docker mode (backend also containerized via `make up`): use minio:9000 instead
# GCP Cloud Storage mode: use https://storage.googleapis.com
CLOUD_STORAGE_ENDPOINT_URL=http://localhost:9010
CLOUD_STORAGE_ACCESS_KEY=fluentsoul
CLOUD_STORAGE_SECRET_KEY=fluentsoul123
CLOUD_STORAGE_BUCKET=fluentsoul-audio
