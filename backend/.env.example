# App
APP_NAME=SoulFluent
ENVIRONMENT=development

# Auth
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Native mode (backend runs on your Mac, Postgres via `make db`): use localhost:5346
# Full Docker mode (backend also containerized via `make up`): use db:5432 instead
DATABASE_URL=postgresql+asyncpg://soulfluent:soulfluent@localhost:5346/soulfluent

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Object storage (MinIO) for turn audio
# Native mode (backend runs on your Mac, MinIO via `make minio`): use localhost:9010
# Full Docker mode (backend also containerized via `make up`): use minio:9000 instead
MINIO_ENDPOINT_URL=http://localhost:9010
MINIO_ACCESS_KEY=soulfluent
MINIO_SECRET_KEY=soulfluent123
MINIO_BUCKET=soulfluent-audio
